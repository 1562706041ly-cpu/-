<mxfile host="app.diagrams.net"><diagram name="框架总图" id="framework"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c11" value="跨域广义类别发现框架：固定 ETF 预训练 + 可靠度门控自适应（Bruinsma 离心泵 → 柱塞泵）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=18;fontColor=#000000;align=center;verticalAlign=middle;arcSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1720" height="34" as="geometry" /></mxCell><mxCell id="c12" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fc;strokeColor=#4a6fa5;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;arcSize=12;dashed=1;container=0;opacity=60;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="400" height="900" as="geometry" /></mxCell><mxCell id="c13" value="A  数据准备" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=15;fontColor=#4a6fa5;align=left;verticalAlign=middle;arcSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="28" y="56" width="360" height="26" as="geometry" /></mxCell><mxCell id="c14" value="&lt;b&gt;源域 S：训练安装&lt;/b&gt;&lt;br&gt;已知类窗口 10% 有标签 (x&lt;sub&gt;s&lt;/sub&gt;, y&lt;sub&gt;s&lt;/sub&gt;)&lt;br&gt;其余无标签（可能含未知故障）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3efff;strokeColor=#1f77d0;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="360" height="92" as="geometry" /></mxCell><mxCell id="c15" value="&lt;b&gt;目标域 T：新设备（留出安装）&lt;/b&gt;&lt;br&gt;全部无标签 x&lt;sub&gt;t&lt;/sub&gt;，含已知 + 未知故障&lt;br&gt;按测量记录拆分：&lt;br&gt;T&lt;sub&gt;adapt&lt;/sub&gt;（训练用） | T&lt;sub&gt;eval&lt;/sub&gt;（只评估）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0e0;strokeColor=#ef7d1a;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="205" width="360" height="112" as="geometry" /></mxCell><mxCell id="c16" value="&lt;b&gt;预处理&lt;/b&gt;&lt;br&gt;Motor-2，100% 转速，4 个振动通道&lt;br&gt;分窗 → 4 通道对数谱（主线）&lt;br&gt;对照：4 通道 STFT/CWT 时频图" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="360" height="78" as="geometry" /></mxCell><mxCell id="c17" value="&lt;b&gt;弱视图 x&lt;sup&gt;w&lt;/sup&gt;&lt;/b&gt;&lt;br&gt;归一化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="445" width="170" height="70" as="geometry" /></mxCell><mxCell id="c18" value="&lt;b&gt;强视图 x&lt;sup&gt;s&lt;/sup&gt;&lt;/b&gt;&lt;br&gt;来自第三章模块" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="225" y="445" width="175" height="70" as="geometry" /></mxCell><mxCell id="c19" value="&lt;b&gt;第三章模块：可靠度感知的强视图生成器&lt;/b&gt;&lt;br&gt;VMD 模态扰动（沙箱预计算）+ 保真检查&lt;br&gt;扰动强度按门控分组分配：&lt;br&gt;可靠已知 → 较强&lt;br&gt;可靠未知 → 中等&lt;br&gt;不确定 → 较弱 / 通用增强&lt;br&gt;保真不通过 → 退回弱视图" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c0392b;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="360" height="150" as="geometry" /></mxCell><mxCell id="c20" value="未知类标签只用于评估与事后诊断&lt;br&gt;阈值、超参数只用源域留一安装验证选取&lt;br&gt;75% 转速数据封存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;fontColor=#000000;align=center;verticalAlign=middle;arcSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="360" height="86" as="geometry" /></mxCell><mxCell id="c21" value="" style="endArrow=block;html=1;strokeColor=#1f77d0;strokeWidth=2;fontSize=11;fontColor=#1f77d0;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c22" value="" style="endArrow=block;html=1;strokeColor=#ef7d1a;strokeWidth=2;fontSize=11;fontColor=#ef7d1a;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c23" value="" style="endArrow=block;html=1;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#666666;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c24" value="" style="endArrow=block;html=1;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#666666;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c25" value="生成" style="endArrow=block;html=1;strokeColor=#c0392b;strokeWidth=2;fontSize=11;fontColor=#c0392b;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c26" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f8ff;strokeColor=#1f5fa8;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;arcSize=12;dashed=1;container=0;opacity=60;" vertex="1" parent="1"><mxGeometry x="440" y="50" width="1300" height="330" as="geometry" /></mxCell><mxCell id="c27" value="B  阶段 ① 预训练（第 0–300 步）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=15;fontColor=#1f5fa8;align=left;verticalAlign=middle;arcSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="448" y="56" width="360" height="26" as="geometry" /></mxCell><mxCell id="c28" value="视图 v" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="465" y="100" width="120" height="44" as="geometry" /></mxCell><mxCell id="c29" value="视图 v′" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="465" y="270" width="120" height="44" as="geometry" /></mxCell><mxCell id="c30" value="编码器 f&lt;sub&gt;θ&lt;/sub&gt;&lt;br&gt;一维 CNN&lt;br&gt;(对照: 一维 ResNet)" style="shape=trapezoid;perimeter=trapezoidPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=18;direction=south;fillColor=#d6e8ff;strokeColor=#1f77d0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="615" y="85" width="150" height="74" as="geometry" /></mxCell><mxCell id="c31" value="目标编码器 f&lt;sub&gt;ξ&lt;/sub&gt;&lt;br&gt;(EMA)" style="shape=trapezoid;perimeter=trapezoidPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=18;direction=south;fillColor=#d6e8ff;strokeColor=#1f77d0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="615" y="255" width="150" height="74" as="geometry" /></mxCell><mxCell id="c32" value="投影 MLP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="795" y="100" width="110" height="44" as="geometry" /></mxCell><mxCell id="c33" value="预测 MLP q&lt;sub&gt;θ&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="925" y="100" width="110" height="44" as="geometry" /></mxCell><mxCell id="c34" value="投影 MLP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="795" y="270" width="110" height="44" as="geometry" /></mxCell><mxCell id="c35" value="sg(z′)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7cc;strokeColor=#666666;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="925" y="270" width="110" height="44" as="geometry" /></mxCell><mxCell id="c36" value="L&lt;sub&gt;BYOL&lt;/sub&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f77d0;fontSize=13;fontColor=#1f77d0;align=center;verticalAlign=middle;arcSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1060" y="185" width="92" height="34" as="geometry" /></mxCell><mxCell id="c37" value="ETF 投影头 g&lt;br&gt;→ L2 归一化 z" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e9e4f;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1150" y="100" width="140" height="44" as="geometry" /></mxCell><mxCell id="c38" value="&lt;b&gt;固定 ETF 原型&lt;/b&gt;（不训练）&lt;br&gt;C 个已知原型 + 3 个未知槽&lt;br&gt;cos = −1/(K−1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e9e4f;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1315" y="85" width="200" height="80" as="geometry" /></mxCell><mxCell id="c39" value="L&lt;sub&gt;src&lt;/sub&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e9e4f;fontSize=13;fontColor=#2e9e4f;align=center;verticalAlign=middle;arcSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1560" y="108" width="92" height="34" as="geometry" /></mxCell><mxCell id="c40" value="&lt;b&gt;目的&lt;/b&gt;：① 不依赖伪标签先学出可用特征（两个域全部窗口参与 BYOL）&lt;br&gt;② 给阶段 ② 的门控与伪标签打底，避免确认偏差&lt;br&gt;③ 源域有标签样本拉向自己的已知原型，同时被推离 3 个未知槽 → 未知位置预留&lt;br&gt;L = L&lt;sub&gt;BYOL&lt;/sub&gt; + L&lt;sub&gt;src&lt;/sub&gt;（类均衡采样）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;fontColor=#000000;align=left;verticalAlign=middle;arcSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="1150" y="190" width="560" height="120" as="geometry" /></mxCell><mxCell id="c41" value="" style="endArrow=block;html=1;strokeColor=#1f77d0;strokeWidth=2;fontSize=11;fontColor=#1f77d0;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="c28" target="c30"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c42" value="" style="endArrow=block;html=1;strokeColor=#1f77d0;strokeWidth=2;fontSize=11;fontColor=#1f77d0;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="c29" target="c31"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c43" value="" style="endArrow=block;html=1;strokeColor=#1f77d0;strokeWidth=2;fontSize=11;fontColor=#1f77d0;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="c30" target="c32"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c44" value="" style="endArrow=block;html=1;strokeColor=#1f77d0;strokeWidth=2;fontSize=11;fontColor=#1f77d0;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="c32" target="c33"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c45" value="" style="endArrow=block;html=1;strokeColor=#1f77d0;strokeWidth=2;fontSize=11;fontColor=#1f77d0;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="c31" target="c34"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c46" value="" style="endArrow=block;html=1;strokeColor=#1f77d0;strokeWidth=2;fontSize=11;fontColor=#1f77d0;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="c34" target="c35"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c47" value="EMA" style="endArrow=open;html=1;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#666666;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c30" target="c31"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c48" value="" style="endArrow=block;html=1;strokeColor=#1f77d0;strokeWidth=2;fontSize=11;fontColor=#1f77d0;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c33" target="c36"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c49" value="" style="endArrow=block;html=1;strokeColor=#1f77d0;strokeWidth=2;fontSize=11;fontColor=#1f77d0;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c35" target="c36"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c50" value="源域有标签" style="endArrow=block;html=1;strokeColor=#2e9e4f;strokeWidth=2;fontSize=11;fontColor=#2e9e4f;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.85;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c30" target="c37"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c51" value="" style="endArrow=block;html=1;strokeColor=#2e9e4f;strokeWidth=2;fontSize=11;fontColor=#2e9e4f;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="c37" target="c38"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c52" value="" style="endArrow=block;html=1;strokeColor=#2e9e4f;strokeWidth=2;fontSize=11;fontColor=#2e9e4f;dashed=1;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="c38" target="c39"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c53" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8f0;strokeColor=#c0661a;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;arcSize=12;dashed=1;container=0;opacity=60;" vertex="1" parent="1"><mxGeometry x="440" y="395" width="1300" height="555" as="geometry" /></mxCell><mxCell id="c54" value="C  阶段 ② 自适应（第 300–1500 步，伪标签每 100 步刷新）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=15;fontColor=#c0661a;align=left;verticalAlign=middle;arcSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="448" y="401" width="360" height="26" as="geometry" /></mxCell><mxCell id="c55" value="编码器 f&lt;br&gt;（继承阶段 ①，&lt;br&gt;可训练）" style="shape=trapezoid;perimeter=trapezoidPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=18;direction=south;fillColor=#d6e8ff;strokeColor=#1f77d0;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="470" width="160" height="190" as="geometry" /></mxCell><mxCell id="c56" value="源域有标签 z&lt;sub&gt;s&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3efff;strokeColor=#1f77d0;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="450" width="150" height="44" as="geometry" /></mxCell><mxCell id="c57" value="目标弱视图 z&lt;sup&gt;w&lt;/sup&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0e0;strokeColor=#ef7d1a;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="540" width="150" height="44" as="geometry" /></mxCell><mxCell id="c58" value="目标强视图 z&lt;sup&gt;s&lt;/sup&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c0392b;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="640" width="150" height="44" as="geometry" /></mxCell><mxCell id="c59" value="&lt;b&gt;固定 ETF 原型&lt;/b&gt;&lt;br&gt;（与阶段 ① 同一组）&lt;br&gt;&lt;br&gt;s&lt;sub&gt;k&lt;/sub&gt; = cos(z, m&lt;sub&gt;k&lt;/sub&gt;)/τ&lt;br&gt;τ = 0.1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e9e4f;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="450" width="170" height="234" as="geometry" /></mxCell><mxCell id="c60" value="&lt;b&gt;门控&lt;/b&gt;：k(x)=max&lt;sub&gt;c≤C&lt;/sub&gt; cos(z&lt;sup&gt;w&lt;/sup&gt;, m&lt;sub&gt;c&lt;/sub&gt;)&lt;br&gt;阈值 t&lt;sub&gt;hi&lt;/sub&gt;/t&lt;sub&gt;lo&lt;/sub&gt;：源域留一安装校准" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7cc;strokeColor=#b8860b;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="520" width="210" height="84" as="geometry" /></mxCell><mxCell id="c61" value="可靠已知&lt;br&gt;→ 已知类伪标签" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3efff;strokeColor=#1f77d0;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1280" y="470" width="170" height="50" as="geometry" /></mxCell><mxCell id="c62" value="可靠未知&lt;br&gt;→ 放宽均衡分配&lt;br&gt;到未知槽 u1/u2/u3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde2e2;strokeColor=#c0392b;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1280" y="540" width="170" height="66" as="geometry" /></mxCell><mxCell id="c63" value="不确定 → 只参与 BYOL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#666666;fontSize=12;fontColor=#000000;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1280" y="622" width="170" height="44" as="geometry" /></mxCell><mxCell id="c64" value="L&lt;sub&gt;src&lt;/sub&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e9e4f;fontSize=13;fontColor=#2e9e4f;align=center;verticalAlign=middle;arcSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1630" y="452" width="92" height="34" as="geometry" /></mxCell><mxCell id="c65" value="L&lt;sub&gt;ta&lt;/sub&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f77d0;fontSize=13;fontColor=#1f77d0;align=center;verticalAlign=middle;arcSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1630" y="500" width="92" height="34" as="geometry" /></mxCell><mxCell id="c66" value="L&lt;sub&gt;unk&lt;/sub&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;fontSize=13;fontColor=#c0392b;align=center;verticalAlign=middle;arcSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1630" y="552" width="92" height="34" as="geometry" /></mxCell><mxCell id="c67" value="L&lt;sub&gt;new&lt;/sub&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;(损失创新，待定)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7b3fa0;fontSize=12;fontColor=#7b3fa0;align=center;verticalAlign=middle;arcSize=12;dashed=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1630" y="604" width="92" height="34" as="geometry" /></mxCell><mxCell id="c68" value="0.1·L&lt;sub&gt;BYOL&lt;/sub&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;fontColor=#666666;align=center;verticalAlign=middle;arcSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1630" y="656" width="92" height="34" as="geometry" /></mxCell><mxCell id="c69" value="&lt;b&gt;总损失&lt;/b&gt;：L = L&lt;sub&gt;src&lt;/sub&gt; + β(t)·(L&lt;sub&gt;ta&lt;/sub&gt; + L&lt;sub&gt;unk&lt;/sub&gt; [+ L&lt;sub&gt;new&lt;/sub&gt;]) + 0.1·L&lt;sub&gt;BYOL&lt;/sub&gt;，β 在第 300–500 步由 0 升到 1&lt;br&gt;L&lt;sub&gt;ta&lt;/sub&gt;：可靠已知样本的强视图拟合弱视图伪标签（拉向已知原型 = 按类跨域对齐，不加 DANN）&lt;br&gt;L&lt;sub&gt;unk&lt;/sub&gt;：可靠未知样本的强视图拟合所分配的未知槽，按槽位类均衡；未知槽固定，无需匹配器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;fontColor=#000000;align=left;verticalAlign=middle;arcSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="